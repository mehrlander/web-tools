{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/refresh-plugin.sh\""
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-dispatch.sh\""
          }
        ]
      },
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/invoke-default.sh\""
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/invoke-sessions.sh\""
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/environment-report.sh\""
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/account-skills.py\" --hook"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/reading-column-guard.sh\""
          }
        ]
      },
      {
        "matcher": "mcp__.*__send_later",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/send-later-guard.sh\""
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/ask-question-guard.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pr-subscribe-hint.sh\""
          }
        ]
      },
      {
        "matcher": "ReadNotifications",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/wake-quiet-hint.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/warn-governing-docs.sh\""
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/mcp-fail-hint.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-record.sh\""
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "prompt",
            "model": "claude-haiku-5-5",
            "timeout": 30,
            "prompt": "You check the reply a Claude Code session is about to end its turn with, reading it as its owner will: without having seen the session. The hook input:\n\n$ARGUMENTS\n\nIf stop_hook_active is true, answer {\"ok\": true}. Otherwise read last_assistant_message and check three things.\n\n1. Decision. If the reply asks the owner to decide, choose or approve something, it says what is being decided, what the options are and which one it recommends.\n2. Status line. A reply longer than one line ends with exactly one status line: a line that starts with one of 🟢 ❇️ 🟡 🆚 ✴️ 🟠 ⚪ 🟣 🔴 ⚫ 🔵 followed by a bold lead. No other line in the reply starts with one of those glyphs.\n3. References. Every numbered or named item the reply points to, such as \"item 7\", \"rows 3 and 5\" or \"your two calls\", is introduced in the reply itself.\n\nIf all three hold, answer {\"ok\": true}. If any fails, answer {\"ok\": false, \"reason\": \"...\"}, where the reason names each failed check, quotes the words, and says what to add. Answer with the JSON object only."
          }
        ]
      }
    ]
  }
}

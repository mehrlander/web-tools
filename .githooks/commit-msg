#!/usr/bin/env bash
# git commit-msg hook — the consent gate, the machine-path gate, then the
# edit-policy gate. All three engines are portable and live in the plugin
# (skills/hooks/commit-consent.py, machine-paths.py, check-edit-policy.py); this
# file is the lines that let git find them, the same split markers/status.py
# already uses. The machine-path gate refuses a commit whose added lines name a
# path into one machine's user folder. The edit-policy gate refuses a change
# that breaks the `edit` attribute .gitattributes gives a file, and passes a
# change whose message names it with `Edit-policy-exception: <path>`. Both gates sit
# here because commit-msg is the hook that refuses, while pre-commit only
# regenerates and warns.
#
# WHY commit-msg AND NOT pre-commit. pre-commit runs before the message exists,
# so it can refuse but cannot read an answer. commit-msg gets the message file
# and can do both, and it works with `git commit -m`, which is how a session
# actually commits: the commit aborts, the prompt lands on stderr, nothing was
# created, the staged files are untouched, and the retry carries the trailer.
#
# --no-verify bypasses, as it does for the size guard and the derived-artifact
# rebuild beside it. These are guardrails, not security controls.
set -u

# Match pre-commit's Git-for-Windows bootstrap before trying cygpath or the
# checkout-local python3 shim. A host may expose Git's cmd directory but omit
# its usr/bin directory from PATH even though Git launches this Bash itself.
git_shell="$(git var GIT_SHELL_PATH 2>/dev/null || true)"
case "$git_shell" in
  */*)
    git_bin="${git_shell%/*}"
    if [ -x "$git_bin/cygpath.exe" ]; then
      git_bin="$("$git_bin/cygpath.exe" -u "$git_bin" 2>/dev/null || printf '%s' "$git_bin")"
    fi
    PATH="$git_bin:$PATH"
    export PATH
    ;;
esac

root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "$root" ] || exit 0
path_root="$root"
if command -v cygpath >/dev/null 2>&1; then
  path_root="$(cygpath -u "$root" 2>/dev/null || printf '%s' "$root")"
fi
PATH="$path_root/node_modules/.bin:$PATH"
PYTHONUTF8=1
PYTHONIOENCODING=utf-8
export PATH PYTHONUTF8 PYTHONIOENCODING

plugin_script() {            # $1 = e.g. hooks/commit-consent.py
  local p
  p="$root/skills/$1"
  [ -f "$p" ] && { echo "$p"; return 0; }          # this repo IS the plugin source
  local reg="$HOME/.claude/plugins/installed_plugins.json"
  p=$(python3 -c "import json,sys;d=json.load(open(sys.argv[1]));print(d['plugins']['portable@web-tools'][0]['installPath'])" "$reg" 2>/dev/null || true)
  [ -n "$p" ] && [ -f "$p/$1" ] && { echo "$p/$1"; return 0; }
  p="$HOME/.claude/plugins/marketplaces/web-tools/skills/$1"
  [ -f "$p" ] && { echo "$p"; return 0; }
  return 1
}

# An engine that is absent never blocks.
if script=$(plugin_script hooks/commit-consent.py); then
  python3 "$script" "$1" || exit 1
fi
if script=$(plugin_script hooks/machine-paths.py); then
  python3 "$script" --staged || exit 1
fi
if script=$(plugin_script hooks/check-edit-policy.py); then
  python3 "$script" --staged --message "$1" || exit 1
fi

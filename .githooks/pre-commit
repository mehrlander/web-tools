#!/usr/bin/env bash
# git pre-commit hook — keep every *deterministic* derived artifact in lockstep
# with its source, in the same commit that changes the source:
#
#   lib/ changed            -> npm run build:lib     -> stage dist/web-tools.js
#   console/ changed        -> npm run build:console -> stage console/suite.js
#   a catalogued .html      -> npm run pages-index   -> stage the three pages catalogs
#
# Both generators are deterministic, so a commit that didn't really change the
# source produces identical bytes (a no-op `git add`). Thumbnails
# (pages/thumbs/*.png) are deliberately NOT regenerated here — screenshots are
# slow and not byte-deterministic, so auto-regen would write binary churn on
# every commit. Instead the hook *warns* when a page's HTML changes without its
# thumbnail, and the refresh happens once per session at wrap-up
# (see CLAUDE.md "Per-session refresh"). Non-blocking: failures warn but never
# stop the commit.
#
# THIS WAS A CLAUDE CODE PreToolUse(Bash) HOOK UNTIL 2026-08-06, and the move to
# git is the whole point. A Claude hook is declared in .claude/settings.json,
# which the harness reads only when the session's project root IS this repo. In
# a multi-repo session the root sits above the checkouts, so the declaration was
# never read and this never ran, silently: measured in a session rooted at
# /home/user, where a lib/ change committed without its dist/ rebuild and the
# gap was noticed by hand. Git resolves its hooks from the repository being
# committed to and has no notion of a project root, so it fires from anywhere.
# The one thing git will not do is find a committed hooks folder by itself, and
# .claude/hooks/session-githooks.sh supplies that single line of config.
#
# Two things came off in the move, both of them scaffolding for the old event:
# the JSON stdin parse that recovered the Bash command, and the `git commit`
# gate. Git only calls this on a commit, so both were answering a question that
# no longer gets asked.
set -euo pipefail

# A desktop host can put Git's cmd/ directory on PATH without its usr/bin/
# directory. Git can still launch this hook, but grep and sed then disappear
# inside it. Ask Git for the shell it actually uses and add that tool directory
# before doing any work. cygpath handles Git for Windows' drive-letter path.
git_shell="$(git var GIT_SHELL_PATH 2>/dev/null || true)"
case "$git_shell" in
  */*)
    git_bin="${git_shell%/*}"
    if [ -x "$git_bin/cygpath.exe" ]; then
      git_bin="$("$git_bin/cygpath.exe" -u "$git_bin" 2>/dev/null || printf '%s' "$git_bin")"
    fi
    PATH="$git_bin:$PATH"
    export PATH
    ;;
esac

# Git runs a hook from the repository top-level, and CLAUDE_PROJECT_DIR is
# exactly the value that is wrong here (it can name a directory ABOVE this
# repo), so ask git rather than the environment.
root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "$root" ] || exit 0

cd "$root" || exit 0

# checkout-setup may provide a local python3 command for platforms that expose
# Python 3 only as `python`. npm scripts add this directory automatically; git
# hooks do not, so put the same dependency command path first here.
path_root="$root"
if command -v cygpath >/dev/null 2>&1; then
  path_root="$(cygpath -u "$root" 2>/dev/null || printf '%s' "$root")"
fi
PATH="$path_root/node_modules/.bin:$PATH"
PYTHONUTF8=1
PYTHONIOENCODING=utf-8
export PATH PYTHONUTF8 PYTHONIOENCODING

# The ordinary hook only runs a leg when its source has a pending change.
# `git hook run pre-commit -- --all` is the explicit repair path for a clean
# fetched tree whose committed artifacts may already be stale (for example,
# after an API write or server-side merge). It reuses this exact order and the
# same warning-versus-blocking policies instead of maintaining a second runner.
refresh_all=0
[ "${1:-}" = "--all" ] && refresh_all=1
changed() {
  [ "$refresh_all" = 1 ] || git status --porcelain -- "$@" | grep -q .
}

# `git add`, but LOUD about a path that is not there. Every add below used the
# form `git add X 2>/dev/null || true`, which cannot tell "nothing to stage" from
# "that file was renamed two months ago." Both happened: PR #441 turned
# docs/docs.json into docs/docs.csv and tracker/board.json into board.csv, and
# from that day the two legs regenerated their registry on every commit and
# staged it on none. The generators were fine, the adds addressed nothing, and
# the silence was written into the line. Found 2026-08-23 when CI failed on a
# words stamp the hook had dutifully computed and dropped.
stage() {
  for f in "$@"; do
    if [ -e "$f" ]; then
      git add "$f" 2>/dev/null || true
    else
      echo "build hook: nothing at $f to stage — renamed, or the generator writes something else now" >&2
    fi
  done
}

# --- leg 1: lib/ -> dist/web-tools.js (the pre-build) -------------------------
if changed lib/; then
  if npm run build:lib --silent >/dev/null 2>&1; then
    stage dist/web-tools.js
  else
    echo "build hook: 'npm run build:lib' failed — committing without refreshing dist/web-tools.js" >&2
  fi
fi

# --- leg 1b: lib/ or pages/dictate.html -> dist/dictate.js --------------------
# The dictation page adopts its own build (tools/build/build.mjs), so a change to
# lib/ or to the page's reach re-emits it. It is the one PER-PAGE build that is
# tracked, and it is tracked because the page imports it: the chain it replaces
# was fourteen serial contents-API round trips, which is what made the page slow
# to open on a phone (measured 2026-09-08).
if changed lib/ pages/dictate.html; then
  if npm run build:dictate --silent >/dev/null 2>&1; then
    stage dist/dictate.js
  else
    echo "build hook: 'npm run build:dictate' failed — committing without refreshing dist/dictate.js" >&2
  fi
fi

# --- leg 1a: lib/ or app/index.html -> dist/app.js (the app's pre-build) ------
# The app imports its own walked build (tools/build/build-app.mjs), so a change
# to the page's reach re-emits it too.
if changed lib/ app/index.html; then
  if npm run build:app --silent >/dev/null 2>&1; then
    stage dist/app.js
  else
    echo "build hook: 'npm run build:app' failed — committing without refreshing dist/app.js" >&2
  fi
fi

# --- leg 1b: console/ -> console/suite.js (base + mods, one paste) ------------
if changed console/base.js console/mods/; then
  if npm run build:console --silent >/dev/null 2>&1; then
    stage console/suite.js
  else
    echo "build hook: 'npm run build:console' failed — committing without refreshing console/suite.js" >&2
  fi
fi

# --- leg 2: a catalogued .html -> the three catalogs --------------------------
# Any pending .html change (add/edit/delete/retitle) in a folder pages-index
# reads regenerates pages/README.md + pages/index.html + pages/pages.csv so the
# catalogs ride in the same commit.
#
# The watch list has to match what the GENERATOR reads, not what the catalogs
# are named. It watched pages/ alone until 2026-09-01, when adding
# lib/kits/demos/note.html left all three catalogs a row short: the hook said
# nothing, the commit went through, and derived-artifacts.test.mjs failed on the
# next run. pages.csv was missing from the stage list on the same terms.
changed_pages="$(git status --porcelain -- pages/ lib/kits/demos/ | grep '\.html' | sed 's/^...//; s/.* -> //' || true)"
if [ "$refresh_all" = 1 ] || [ -n "$changed_pages" ]; then
  if npm run pages-index --silent >/dev/null 2>&1; then
    stage pages/README.md pages/index.html pages/pages.csv
  else
    echo "build hook: 'npm run pages-index' failed — committing without refreshing the pages catalogs" >&2
  fi

  # --- leg 3: thumbnail nudge (warn only, never regenerate) -------------------
  # `virt` mirrors the SOURCES table in tools/build/pages-shots.mjs: a kit demo
  # is shot under its virtual folder, not its real path, and pages-shots names
  # its arguments the same way. Get this wrong and the nudge points at a
  # thumbnail that does not exist and hands over a command that shoots nothing.
  while [ -n "$changed_pages" ] && IFS= read -r p; do
    # The two folder indexes are generated listings, not catalogued pages, so
    # neither has a thumbnail to nag about. lib/kits/demos/index.html was
    # nagged on every touch until 2026-09-05: pages-shots is handed a name the
    # catalog does not carry and silently shoots nothing.
    case "$p" in pages/index.html|lib/kits/demos/index.html|pages/thumbs/*) continue ;; esac
    case "$p" in
      lib/kits/demos/*) virt="kit-demos/${p#lib/kits/demos/}" ;;
      *)                virt="${p#pages/}" ;;
    esac
    thumb="pages/thumbs/${virt}"; thumb="${thumb%.html}.png"
    if [ -e "$root/$p" ] && ! git status --porcelain -- "$thumb" | grep -q .; then
      echo "build hook: $p changed but $thumb didn't — refresh at wrap-up: npm run pages-shots -- $virt" >&2
    fi
  done <<< "$changed_pages"
fi

# --- leg 2b: tools/test/ -> the test registry's derived fields ----------------
# Must precede leg 3a, not follow it. This writes docs/tests.csv, and
# docs/tests.csv is a row in docs/docs.json, so a restamp here invalidates any
# word count 3a had already taken. Running it after 3a leaves the suite failing
# on exactly one row, which is how the ordering was found.
if changed tools/test package.json tools/build/tests-index.mjs; then
  if npm run tests-index --silent >/dev/null 2>&1; then
    stage docs/tests.csv
  else
    echo "build hook: 'npm run tests-index' failed — docs/tests.csv may be stale" >&2
  fi
fi

# --- leg 2c: tools/ or scripts/ -> the harness census's derived fields --------
# docs/harness.csv is authored only in `role` and the layer glossary; layer,
# lines, invocation, emits, named, and tested are stamped from the tree, and a
# rename or a new npm script moves them without touching the registry.
# artifacts-lockstep runs the generator's --check as the backstop.
if changed tools scripts package.json tools/build/tools-index.mjs docs/harness.csv; then
  if npm run tools-index --silent >/dev/null 2>&1; then
    stage docs/harness.csv
  else
    echo "build hook: 'npm run tools-index' failed — docs/harness.csv may be stale" >&2
  fi
fi

# --- leg 2c2: lib/kits/ -> the kits registry ----------------------------------
# docs/kits.csv authors nothing: namespace, headline, boot, demo, users and
# tested are all read off the tree, so any change on the shelf, to a demo, to a
# page that loads a kit, or to the boot manifest can move a row.
if changed lib pages app tools/test tools/build/kits-index.mjs docs/kits.csv; then
  if npm run kits-index --silent >/dev/null 2>&1; then
    stage docs/kits.csv
  else
    echo "build hook: 'npm run kits-index' failed — docs/kits.csv may be stale" >&2
  fi
fi

# --- leg 2d: lib/ or pages/ -> the registries' renders_in field ---------------
# docs/registries.csv is authored everywhere except `renders_in`, the app
# files that name each registry, stamped the way leg 3a stamps reach. Must
# precede 3a: this writes docs/registries.csv, which is a docs/ file whose
# word count 3a measures. properties-registry.test.mjs is the backstop.
if changed lib pages docs/registries.csv tools/build/registries-reach.mjs; then
  if npm run registries-reach --silent >/dev/null 2>&1; then
    stage docs/registries.csv
  else
    echo "build hook: 'npm run registries-reach' failed — renders_in may be stale" >&2
  fi
fi

# --- leg 2e: docs/SNAGS.md -> its index, plus the repeat warning --------------
# BEFORE leg 3a, and that ordering is the whole reason this moved. This leg
# REWRITES a file in docs/, and leg 3a measures every docs/ file's length into
# the registry's `words`. Running after it meant the stamp was taken against
# SNAGS.md as authored and the index block was regenerated a moment later, so
# docs/docs.json was stale by exactly that block's delta on every commit that
# touched the log. Nothing local said so, because the hook does not verify what
# it stamps: docs-registry.test.mjs caught it, in CI, after the push, on 2026-08-23
# (PR #488, declared 9412 against an actual 9430). Same shape as the 3a/3b cycle
# one leg down, and settled the same way, by making the measurement last.
#
# The index is deterministic and rides the same rule as the rest. The repeat
# warning is the reason this leg exists at all: it fires while the new entry is
# being committed, which is the last moment folding it into the entry that
# already owns it is cheap. So the generator's stdout is shown rather than
# swallowed, unlike the legs above.
#
# BOTH OUTPUTS ARE STAGED, and only one was. The generator rewrites the index
# block inside docs/SNAGS.md AND emits docs/snags.csv, and this leg staged the
# markdown alone. So every commit touching the log left the csv dirty in the
# working tree, which the stop hook caught three times (2026-09-07, 2026-09-08)
# and no gate did: the csv is not compared against its source by the suite the
# way dist/ is, so nothing on the way to a merge would have noticed.
if changed docs/SNAGS.md; then
  if out="$(npm run snags-index --silent 2>&1)"; then
    stage docs/SNAGS.md
    stage docs/snags.csv
    printf '%s\n' "$out" >&2
  else
    echo "build hook: 'npm run snags-index' failed — committing without refreshing the snags index" >&2
  fi
fi

# --- leg 3a: skills/pages/lib -> the registry's derived fields ----------------
# `reach` and `words` are the derived fields inside an otherwise authored file:
# pointing a skill or a page at a doc changes the first, and editing any doc's
# length changes the second, and both edits are nowhere near docs/docs.json.
# Restamp before leg 3b so the README projects the new value in the same commit.
# docs-registry.test.mjs is the backstop where the hook does not run.
if changed .claude/skills skills lib pages docs tools/build/docs-reach.mjs; then
  if npm run docs-reach --silent >/dev/null 2>&1; then
    stage docs/docs.csv
  else
    echo "build hook: 'npm run docs-reach' failed — docs/docs.json reach may be stale" >&2
  fi
fi

# --- leg 3e: the traveling docs -> the plugin's copies ------------------------
# The default skill ships its own copy of each doc it delivers, so a session
# that installed the plugin reads them off disk. docs/ is authoritative; this
# keeps the copy from drifting in the commit that moves the source, which is
# how it drifted before (resynced by hand in 2b785b2).
if changed docs/SURFACING.md docs/surfacing-course.md docs/QUALIFIED-WRITING.md tools/build/vendor-docs.mjs; then
  if npm run vendor-docs --silent >/dev/null 2>&1; then
    stage .claude/skills/default/SURFACING.md .claude/skills/default/surfacing-course.md .claude/skills/default/QUALIFIED-WRITING.md
  else
    echo "build hook: 'npm run vendor-docs' failed - the plugin's doc copies may be stale" >&2
  fi
fi

# --- leg 3d: any markdown -> the theme graph ----------------------------------
# docs/themes.csv is the duplication graph the Map view's Themes tab reads, and
# every edge in it is a fact about prose, so any .md edit can move it. Cheap
# (about 1.2s) and byte-stable by construction: keys sorted, one separator.
if changed '*.md' scripts/duplicated-claims.py; then
  if npm run themes-graph --silent >/dev/null 2>&1; then
    stage docs/themes.csv
  else
    echo "build hook: 'npm run themes-graph' failed - docs/themes.csv may be stale" >&2
  fi
fi

# --- leg 3b: docs/docs.json -> docs/README.md ---------------------------------
# The docs index is a projection of the documentation registry; regenerate it
# whenever the registry (or the generator) has pending changes.
if changed docs/docs.csv tools/build/docs-readme.mjs; then
  if npm run docs-readme --silent >/dev/null 2>&1; then
    stage docs/README.md
  else
    echo "build hook: 'npm run docs-readme' failed — committing without refreshing docs/README.md" >&2
  fi

  # --- leg 3c: docs/README.md -> the registry's word count -------------------
  # 3a and 3b are a cycle, and adding `words` is what closed it. docs/README.md
  # is generated FROM the registry and is also a row IN it, so leg 3b changes a
  # file whose size leg 3a measured a moment earlier. One more stamp settles it,
  # and it terminates: the README renders path, subject, status, and reach, none
  # of which this pass touches, so nothing sends control back to 3b.
  if npm run docs-reach --silent >/dev/null 2>&1; then
    stage docs/docs.csv
  else
    echo "build hook: 'npm run docs-reach' re-stamp failed — docs/docs.json words may be stale" >&2
  fi
fi

# --- leg 4: tracker/tasks/ -> tracker/board.md + board.json -------------------
if changed tracker/tasks/; then
  if npm run tracker-board --silent >/dev/null 2>&1; then
    stage tracker/board.md tracker/board.csv tracker/board-tags.csv
  else
    echo "build hook: 'npm run tracker-board' failed — committing without refreshing the tracker rollups" >&2
  fi
fi

# --- leg 4b: reading columns (warn only) --------------------------------------
# The PreToolUse guard in the portable plugin refuses these as they are written,
# and tools/test/reading-column.test.mjs fails CI on any that land, so this leg
# exists for the third case only: a file edited outside this session's harness,
# where the guard never ran and the suite has not been run yet.
if [ -f .claude/skills/hooks/reading-column.py ]; then
  out="$(python3 .claude/skills/hooks/reading-column.py lib pages app 2>/dev/null || true)"
  case "$out" in
    *'reading-column: none'*) ;;
    '') ;;
    *) printf 'build hook: %s\n' "$out" >&2 ;;
  esac
fi

# --- leg 5: SUNSET markers now due (warn only) --------------------------------
# Back-compat shims are tagged SUNSET(YYYY-MM-DD); warn at commit time once a
# marker's date has passed so it gets removed rather than lingering forever.
if [ -f scripts/sunset-scan.py ]; then
  out="$(python3 scripts/sunset-scan.py 2>/dev/null || true)"
  [ -n "$out" ] && printf '%s\n' "$out" >&2 || true
fi

# --- leg 6: a Wrong marker on a file nothing declares a record (BLOCKS) -------
# The one marker rule a fact can settle. Wrong preserves a claim in a dated
# record; a living document gets the claim corrected and the marker records what
# it used to say, which is Corrected. So this refuses a Wrong on an undeclared
# path and says which word to use instead. No question, no justification field:
# the declaration answers it, which is what stops a session from reasoning its
# way past the gate the way it reasoned its way into the mistake.
if [ -f .claude/skills/markers/status.py ]; then
  python3 .claude/skills/markers/status.py gate || exit 1
fi

exit 0

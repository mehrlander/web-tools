#!/usr/bin/env bash
# git pre-commit hook: run the commit rules (docs/commit-rules.csv) over the
# pending changes through node/build/commit-rules.mjs, which rebuilds and stages
# the generated files they touch and prints the checks' warnings. It never
# blocks a commit. `git hook run pre-commit -- --all` passes --all through.
#
# A git hook rather than a Claude Code hook, so it fires whatever the session's
# project root is. `npm run setup` points git at this folder.
set -euo pipefail

# A desktop host can put Git's cmd/ directory on PATH without its usr/bin/
# directory. Git can still launch this hook, but the tools beside its shell then
# disappear inside it. Ask Git for the shell it actually uses and add that tool
# directory. cygpath handles Git for Windows' drive-letter path.
git_shell="$(git var GIT_SHELL_PATH 2>/dev/null || true)"
case "$git_shell" in
  */*)
    git_bin="${git_shell%/*}"
    if [ -x "$git_bin/cygpath.exe" ]; then
      git_bin="$("$git_bin/cygpath.exe" -u "$git_bin" 2>/dev/null || printf '%s' "$git_bin")"
    fi
    PATH="$git_bin:$PATH"
    export PATH
    ;;
esac

# Ask git for the repository, not the environment: CLAUDE_PROJECT_DIR can name
# a directory above this checkout.
root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "$root" ] || exit 0
cd "$root" || exit 0

node node/build/commit-rules.mjs "$@" || echo "pre-commit: node/build/commit-rules.mjs did not run; committing without the commit rules" >&2

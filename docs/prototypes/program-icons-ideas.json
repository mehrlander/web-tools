{
  "title": "Program icons",
  "subject": "A cue that marks an icon as a program’s, not a project’s",
  "made": "2026-11-01",
  "brief": {
    "result": "In the app’s lists, at 16 to 24 px, a reader can tell a program’s icon from a project’s, and tell the programs apart.",
    "musts": [
      "Each program in its own colour",
      "One cue that no project or repository icon carries",
      "The mark legible at 16 px",
      "The project icons’ rules: solid ink in one colour, no strokes, gaps of 2.5 units or more"
    ]
  },

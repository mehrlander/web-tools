  "events": [
    {
      "id": "start",
      "name": "A session starts",
      "short": "Start",
      "icon": "ph-play",
      "trigger": "you: a new session, or a resume",
      "effects": {
        "github": {
          "state": "used",
          "label": "repos cloned from it",
          "evidence": "documented",
          "source": "environment"
        },
        "settings": {
          "state": "used",
          "label": "read",
          "evidence": "documented",
          "source": "persistent"
        },
        "snapshot": {
          "state": "used",
          "label": "copied; never written to",
          "evidence": "measured",
          "source": "carries"
        },
        "conversation": {
          "state": "new",
          "label": "begins, or comes back on a resume",
          "evidence": "documented",
          "source": "environment"
        },
        "disk": {
          "state": "new",
          "label": "made from the snapshot; plugin moved to main",
          "evidence": "measured",
          "source": "outlive"
        },
        "boot": {
          "state": "new",
          "label": "starts; start hooks run from the snapshot's plugin pin",
          "evidence": "inferred",
          "source": "refresher"
        }
      }
    },
    {
      "id": "restart",
      "name": "The machine restarts",
      "short": "Restart",
      "icon": "ph-power",
      "trigger": "the harness, unannounced",
      "effects": {
        "github": {
          "state": "untouched",
          "label": "untouched"
        },
        "settings": {
          "state": "untouched",
          "label": "untouched"
        },
        "snapshot": {
          "state": "untouched",
          "label": "untouched"
        },
        "conversation": {
          "state": "kept",
          "label": "kept",
          "evidence": "measured",
          "source": "outlive"
        },
        "disk": {
          "state": "kept",
          "label": "kept, all of it",
          "evidence": "measured",
          "source": "outlive"
        },
        "boot": {
          "state": "lost",
          "label": "processes end; boot files rewritten",
          "evidence": "measured",
          "source": "carries"
        }
      }
    },
    {
      "id": "reclaim",
      "name": "The container is reclaimed",
      "short": "Reclaim",
      "icon": "ph-recycle",
      "trigger": "the harness, after 3 days to 3 weeks idle",
      "effects": {
        "github": {
          "state": "untouched",
          "label": "pushed work is safe here"
        },
        "settings": {
          "state": "untouched",
          "label": "untouched"
        },
        "snapshot": {
          "state": "used",
          "label": "the current one seeds the resume",
          "evidence": "documented",
          "source": "environment"
        },
        "conversation": {
          "state": "partial",
          "label": "back on a resume, maybe partly",
          "evidence": "measured",
          "source": "outlive"
        },
        "disk": {
          "state": "lost",
          "label": "gone, unpushed work with it",
          "evidence": "measured",
          "source": "outlive"
        },
        "boot": {
          "state": "lost",
          "label": "gone",
          "evidence": "measured",
          "source": "outlive"
        }
      }
    },
    {
      "id": "rebuild",
      "name": "The snapshot is rebuilt",
      "short": "Rebuild",
      "icon": "ph-pencil-simple-line",
      "trigger": "you edit the settings box, or about 7 days pass",
      "effects": {
        "github": {
          "state": "untouched",
          "label": "untouched"
        },
        "settings": {
          "state": "new",
          "label": "your edit, if there was one",
          "evidence": "documented",
          "source": "persistent"
        },
        "snapshot": {
          "state": "new",
          "label": "replaced; only new containers use it",
          "evidence": "documented",
          "source": "persistent"
        },
        "conversation": {
          "state": "untouched",
          "label": "untouched"
        },
        "disk": {
          "state": "untouched",
          "label": "running sessions keep theirs",
          "evidence": "documented",
          "source": "persistent"
        },
        "boot": {
          "state": "untouched",
          "label": "untouched"
        }
      }
    },
    {
      "id": "sync",
      "name": "Push and fetch",
      "short": "Push · fetch",
      "icon": "ph-arrows-down-up",
      "trigger": "the session",
      "effects": {
        "github": {
          "state": "new",
          "label": "takes pushes, serves fetches",
          "evidence": "measured",
          "source": "concurrent"
        },
        "settings": {
          "state": "untouched",
          "label": "untouched"
        },
        "snapshot": {
          "state": "untouched",
          "label": "never written by a session",
          "evidence": "measured",
          "source": "carries"
        },
        "conversation": {
          "state": "untouched",
          "label": "untouched"
        },
        "disk": {
          "state": "used",
          "label": "sends commits, takes updates",
          "evidence": "measured",
          "source": "concurrent"
        },
        "boot": {
          "state": "untouched",
          "label": "untouched"
        }
      }
    }
  ],

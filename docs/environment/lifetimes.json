      "name": "claude.ai settings",
      "icon": "ph-sliders-horizontal",
      "lifetime": "until you edit them",
      "holds": [
        {
          "name": "setup-script text",
          "gloss": "the commands in the environment settings box, run when a snapshot is built"
        },
        {
          "name": "network policy",
          "gloss": "which hosts the environment may reach; changing it rebuilds the snapshot"
        },
        {
          "name": "environment variables",
          "gloss": "values set in the environment settings, present in every session"
        },
        {
          "name": "preferences",
          "gloss": "your claude.ai personal preferences, added to every session"
        },
        {
          "name": "uploaded skills",
          "gloss": "skills uploaded to the claude.ai account, copied into each machine at boot"
        }

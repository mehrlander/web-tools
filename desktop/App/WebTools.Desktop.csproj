<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WebTools.Desktop</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/WebTools.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/WebTools.ico" />
    <Resource Include="../../apple-touch-icon.png" Link="Assets/WebTools.png" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <Compile Remove="LaptopSignals.cs;UserSettings.cs" />
    <ProjectReference Include="../Machine/WebTools.Desktop.Machine.csproj" />
    <ProjectReference Include="../Core/WebTools.Desktop.Core.csproj" />
    <Content Include="../ui/**" Link="ui/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../shared/now-shared.js" Link="ui/now-shared.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../shared/usage-view.js" Link="ui/usage-view.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../node_modules/@tailwindcss/browser/dist/index.global.js" Link="ui/vendor/tailwind.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../lib/kits/assistant-mark.js" Link="ui/vendor/assistant-mark.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../lib/kits/claude-mark.js" Link="ui/vendor/claude-mark.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../lib/kits/title-tip.js" Link="ui/vendor/title-tip.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckDesktopStyleRuntime" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('../../node_modules/@tailwindcss/browser/dist/index.global.js')" Text="Run npm run setup from the repository root before building the desktop app." />
  </Target>
</Project>

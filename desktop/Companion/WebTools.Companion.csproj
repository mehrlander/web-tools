<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WebTools.Companion</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Machine/WebTools.Desktop.Machine.csproj" />
    <Content Include="../phone/**" Link="phone/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../node_modules/@tailwindcss/browser/dist/index.global.js" Link="phone/vendor/tailwind.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../lib/kits/assistant-mark.js" Link="phone/vendor/assistant-mark.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../lib/kits/claude-mark.js" Link="phone/vendor/claude-mark.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../lib/favicon.svg" Link="phone/icon.svg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../apple-touch-icon.png" Link="phone/apple-touch-icon.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

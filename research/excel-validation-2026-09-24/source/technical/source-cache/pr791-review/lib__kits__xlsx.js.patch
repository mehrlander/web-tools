+  // Regional marking for native Excel Tables (ListObjects) and PivotTables.
+  // Neither writes visual theme styles into cell formatting (cellXfs), so
+  // this labels structural roles (headers, striping, subtotals, grand totals,
+  // filter carets, and hierarchy parent toggles) from the table bounding boxes.
+  function markTablesAndPivots(rows, sheet, xl) {
+    if (!xl) return;
+
+    // 1. Tables (ListObjects / QueryTables)
+    const tables = (sheet.tables || []).map(p => xl.tables?.[p]).filter(Boolean);
+    for (const tbl of tables) {
+      const rng = parseRange(tbl.ref);
+      if (!rng) continue;
+      const hrc = tbl.headerRowCount != null ? tbl.headerRowCount : 1;
+      const trc = tbl.totalsRowCount != null ? tbl.totalsRowCount : 0;
+      const dataStart = rng.r1 + hrc;
+      const dataEnd = rng.r2 - trc;
+      const showStripes = tbl.styleInfo ? tbl.styleInfo.showRowStripes : true;
+
+      for (const r of rows) {
+        if (r.row < rng.r1 || r.row > rng.r2) continue;
+        const isHeader = r.row < dataStart;
+        const isTotal = trc > 0 && r.row > dataEnd;
+        const isData = !isHeader && !isTotal;
+        const isStripe = isData && showStripes && ((r.row - dataStart) % 2 === 1);
+
+        for (const cell of r.cells) {
+          if (cell.col < rng.c1 || cell.col > rng.c2) continue;
+          if (isHeader) {
+            cell.tableRole = 'tbl-hdr';
+            cell.hasFilter = true;
+          } else if (isTotal) {
+            cell.tableRole = 'tbl-total';
+          } else if (isStripe) {
+            cell.tableRole = 'tbl-stripe';
+          } else {
+            cell.tableRole = 'tbl-data';
+          }
+        }
+      }
+    }
+
+    // 2. Pivot Tables
+    const pivots = (sheet.pivotTables || []).map(p => xl.pivotTables?.[p]).filter(Boolean);
+    for (const pt of pivots) {
+      const rng = parseRange(pt.ref);
+      if (!rng) continue;
+      const fdr = pt.firstDataRow != null ? pt.firstDataRow : 1;
+      const dataStartRow = rng.r1 + fdr;
+      const fdc = pt.firstDataCol != null ? pt.firstDataCol : 1;
+      const dataStartCol = rng.c1 + fdc;
+
+      for (const r of rows) {
+        if (r.row < rng.r1 || r.row > rng.r2) continue;
+        const isHeaderRow = r.row < dataStartRow;
+        const isGrandTotal = r.row === rng.r2;
+
+        let isSubtotal = false;
+        if (!isHeaderRow && !isGrandTotal) {
+          for (const c of r.cells) {
+            if (c.col >= rng.c1 && c.col < dataStartCol) {
+              const txt = (c.text || '').trim();
+              if (txt && /total$/i.test(txt) && !/grand total$/i.test(txt)) {
+                isSubtotal = true;
+                break;
+              }
+            }
+          }
+        }
+
+        for (const cell of r.cells) {
+          if (cell.col < rng.c1 || cell.col > rng.c2) continue;
+          if (isHeaderRow) {
+            cell.pvtRole = 'pvt-hdr';
+            if (r.row === dataStartRow - 1 || cell.text) cell.hasFilter = true;
+          } else if (isGrandTotal) {
+            cell.pvtRole = 'pvt-grandtotal';
+          } else if (isSubtotal) {
+            cell.pvtRole = 'pvt-subtotal';
+          } else if (cell.col < dataStartCol) {
+            cell.pvtRole = 'pvt-row-hdr';
+            if (cell.text && !cell.text.includes('Total') && cell.col === rng.c1) {
+              cell.hasHierarchyToggle = true;
+            }
+          } else {
+            cell.pvtRole = 'pvt-data';
+          }
+        }
+      }
+    }
+  }
